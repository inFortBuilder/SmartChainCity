{
  "name": "@scc/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "tsx src/main.ts",
    "lint": "tsc --noEmit -p .",
    "test": "vitest run",
    "load": "tsx --env-file-if-exists=.env scripts/load.ts",
    "load:city": "tsx --env-file-if-exists=.env scripts/load-city.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.27",
    "@colyseus/schema": "5.0.45",
    "@colyseus/ws-transport": "0.18.4",
    "@scc/shared": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "jose": "^6.2.14"
  }
}
