# Copie para .env.
PORT=8050
HOST=127.0.0.1
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres): o realtime só valida o token.
JWT_SECRET=
JWT_ISSUER=scc-gateway
# Jogadores por instância de sala (doc 05: 50–100).
MAX_CLIENTS=100
# Token dos outros serviços para os eventos globais (/internal/v1/broadcast), 32+ caracteres.
INTERNAL_TOKEN=
