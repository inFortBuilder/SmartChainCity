# Copie para .env. Nunca versione o .env.
PORT=8000
HOST=127.0.0.1

# Banco local de `pnpm db:up` ou do Docker Compose. Vazio = memória, que perde
# tudo ao reiniciar.
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc

# Segredo HS256 do JWT, com pelo menos 32 caracteres. É o mesmo jwt_secret do
# SCC Builder. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Domínio que aparece na mensagem SIWE, separado por vírgula. Assinatura para
# outro domínio é recusada: é a proteção contra phishing de login.
SIWE_DOMAINS=localhost:5173,localhost:8081

# Redes aceitas: 97 = BSC Testnet, 56 = BSC.
SIWE_CHAIN_IDS=97

CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Observabilidade (infra/observability). Nível do log JSON: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info
# Token do Prometheus para ler /metrics (32+ caracteres). Vazio: /metrics aberto em dev e desligado em produção.
METRICS_TOKEN=
