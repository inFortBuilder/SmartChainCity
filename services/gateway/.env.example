# Copie para .env. Nunca versione o .env.
PORT=8000
HOST=127.0.0.1

# Segredo HS256 do JWT, com pelo menos 32 caracteres. É o mesmo jwt_secret do
# SCC Builder. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Domínio que aparece na mensagem SIWE, separado por vírgula. Assinatura para
# outro domínio é recusada: é a proteção contra phishing de login.
SIWE_DOMAINS=localhost:5173

# Redes aceitas: 97 = BSC Testnet, 56 = BSC.
SIWE_CHAIN_IDS=97

CORS_ORIGINS=http://localhost:5173
