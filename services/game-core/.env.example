# Copie para .env. O game-core valida o token do gateway com o mesmo segredo.
PORT=8020
HOST=127.0.0.1
# Sem DATABASE_URL os avatares ficam em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres).
JWT_SECRET=
JWT_ISSUER=scc-gateway
# Chave dos serviços internos (mínimo 32 caracteres).
INTERNAL_TOKEN=
# Intervalo do job de queda dos atributos, em segundos.
DECAY_EVERY_SECONDS=900
# Intervalo do job que conclui turnos, em segundos.
SHIFT_CHECK_SECONDS=60
# Ledger que paga os turnos: a URL do economy e o INTERNAL_TOKEN dele.
ECONOMY_URL=http://127.0.0.1:8010
ECONOMY_TOKEN=
# Origens do navegador que podem chamar a API (mapa local e SCC Builder).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Só desenvolvimento (recusados em produção): avatar de teste para quem não tem
# e turno encurtado para N minutos, pagando como 6 ou 12 h.
DEV_FREE_AVATAR=false
DEV_SHIFT_MINUTES=
# Strapi com o catálogo publicado (sem ele, vale o seed em cms-strapi/seed).
CMS_URL=http://127.0.0.1:1337

# Observabilidade (infra/observability). Nível do log JSON: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info
# Token do Prometheus para ler /metrics (32+ caracteres). Vazio: /metrics aberto em dev e desligado em produção.
METRICS_TOKEN=
