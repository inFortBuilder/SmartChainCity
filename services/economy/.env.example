# Copie para .env. O economy valida o token do gateway com o mesmo segredo.
PORT=8010
HOST=127.0.0.1
# Sem DATABASE_URL o ledger roda em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres).
JWT_SECRET=
JWT_ISSUER=scc-gateway
# Chave dos serviços internos para lançar no ledger (mínimo 32 caracteres).
INTERNAL_TOKEN=
# Origens do navegador que podem chamar a API (mapa local e SCC Builder).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Observabilidade (infra/observability). Nível do log JSON: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info
# Token do Prometheus para ler /metrics (32+ caracteres). Vazio: /metrics aberto em dev e desligado em produção.
METRICS_TOKEN=

# Só desenvolvimento (recusada em produção): torneira de 1.000 SCITY de teste.
DEV_FAUCET=false

# Painel econômico (E2.8): intervalo do job que põe os indicadores no /metrics. 0 desliga.
PANEL_EVERY_SECONDS=60

# Câmbio THALER ↔ SCITY: preço do SCITY para a primeira cotação (as seguintes vêm de POST /internal/v1/economy/fx).
SCITY_USD=1
# Início da liberação do pool P2E (TGE), para o freio do pool. Vazio: freio desligado.
P2E_START=
# Fim do período grátis (ADR-0014): o THALER ganho antes não vira SCITY. Vazio: sem período grátis.
FREE_PERIOD_UNTIL=
# Cotação pelo TWAP da DEX (job fx.twap), com o RPC_URL abaixo. Vazios: cotação só pela rota interna.
# No anvil, o LocalDexPool e o SCityToken do DeployLocal (contracts/deployments/anvil.json).
# Na BSC, o pool SCITY/USDT da PancakeSwap V3, com observações para 24 h (increaseObservationCardinalityNext).
DEX_POOL_ADDRESS=
SCITY_ADDRESS=
FX_TWAP_SECONDS=86400
FX_PERIOD_HOURS=24
FX_MAX_JUMP_BPS=5000
FX_CHECK_SECONDS=600

# Saque pelo GameVault (E3.7). Sem os cinco abaixo, as rotas de saque respondem 503.
# GATEWAY_TOKEN é o INTERNAL_TOKEN do gateway. VAULT_SIGNER_KEY: só no MVP local (KMS em produção);
# no anvil, a conta 0, que o DeployLocal fez signer do cofre.
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
GAME_VAULT_ADDRESS=0x68B1D87F95878fE05B998F19b66F4baba5De1aed
WITHDRAW_EVERY_SECONDS=60
VAULT_SIGNER_KEY=
# Fim do saque.
