# Copie para .env. O economy valida o token do gateway com o mesmo segredo.
PORT=8010
HOST=127.0.0.1
# Sem DATABASE_URL o ledger roda em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres).
JWT_SECRET=
JWT_ISSUER=scc-gateway
# Chave dos serviços internos para lançar no ledger (mínimo 32 caracteres).
INTERNAL_TOKEN=
# Origens do navegador que podem chamar a API (mapa local e SCC Builder).
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Observabilidade (infra/observability). Nível do log JSON: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info
# Token do Prometheus para ler /metrics (32+ caracteres). Vazio: /metrics aberto em dev e desligado em produção.
METRICS_TOKEN=
