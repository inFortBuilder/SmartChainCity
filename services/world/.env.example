# Copie para .env. O world valida o token do gateway com o mesmo segredo.
PORT=8030
HOST=127.0.0.1
# Sem DATABASE_URL os lotes ficam em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres).
JWT_SECRET=
JWT_ISSUER=scc-gateway
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Ledger que cobra os lotes: a URL do economy e o INTERNAL_TOKEN dele.
ECONOMY_URL=http://127.0.0.1:8010
ECONOMY_TOKEN=
# Cotação em US$ por SCITY, fixa até o câmbio do economy.
SCITY_USD=1
SETTLE_EVERY_SECONDS=60
# Job tax.charge: contas de IPTU e PT e débito automático (segundos).
TAX_EVERY_SECONDS=3600

# SCC Builder (tools/scc-builder): valida os prédios dos construtores. Use o mesmo JWT_SECRET no Builder
# (SCC_BUILDER_JWT_SECRET): o world repassa o token do jogador. Vazio: envio de prédio responde 503.
BUILDER_URL=http://127.0.0.1:8090
# Token das ferramentas internas (alvará dos prédios), 32+ caracteres. Vazio: /internal responde 503.
INTERNAL_TOKEN=

# Observabilidade (infra/observability). Nível do log JSON: fatal, error, warn, info, debug ou trace.
LOG_LEVEL=info
# Token do Prometheus para ler /metrics (32+ caracteres). Vazio: /metrics aberto em dev e desligado em produção.
METRICS_TOKEN=

# Posse on-chain do lote (LandNFT, contracts/README.md). Sem GATEWAY_URL, GATEWAY_TOKEN,
# LAND_NFT_ADDRESS e LAND_SIGNER_KEY, a rota de cotação responde 503.
# Gateway que confere a carteira do jogador: a URL e o INTERNAL_TOKEN dele.
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=
# Rede e contrato: 31337 é o anvil; o endereço está em contracts/deployments/anvil.json.
CHAIN_ID=31337
LAND_NFT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# Chave do papel SIGNER do LandNFT. Só no MVP local (em produção, KMS). Gere com
# `cast wallet new` e faça o deploy com WORLD_SIGNER=<endereço dessa chave>.
LAND_SIGNER_KEY=
# Id numérico de cada cidade no contrato.
LAND_CITY_IDS=pittsburg=1
QUOTE_TTL_SECONDS=600
