# Copie para .env. O world valida o token do gateway com o mesmo segredo.
PORT=8030
HOST=127.0.0.1
# Sem DATABASE_URL os lotes ficam em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
# O mesmo JWT_SECRET do gateway (mínimo 32 caracteres).
JWT_SECRET=
JWT_ISSUER=scc-gateway
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Ledger que cobra os lotes: a URL do economy e o INTERNAL_TOKEN dele.
ECONOMY_URL=http://127.0.0.1:8010
ECONOMY_TOKEN=
# Cotação em US$ por SCITY, fixa até o câmbio do economy.
SCITY_USD=1
SETTLE_EVERY_SECONDS=60
