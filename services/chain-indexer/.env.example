# Copie para .env.
PORT=8040
HOST=127.0.0.1
# Sem DATABASE_URL os eventos ficam em memória (só para desenvolvimento).
DATABASE_URL=postgresql://scc:scc_dev@127.0.0.1:5433/scc
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Token dos outros serviços para o feed /internal/v1/chain/events (32+ caracteres).
INTERNAL_TOKEN=

# Rede. Anvil local: chain 31337, 0 ou 1 confirmação. BSC: 56 e 15 confirmações.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONFIRMATIONS=1
# Primeiro bloco a ler (o do deploy). Lotes de leitura e profundidade da volta na reorganização.
START_BLOCK=0
BATCH_BLOCKS=2000
REORG_DEPTH=64
POLL_SECONDS=3
# Endereços dos contratos: do arquivo de deploy, ou um a um (LAND_NFT_ADDRESS, AVATAR_NFT_ADDRESS, LUCKY_BOX_ADDRESS, PROPERTY_NFT_ADDRESS, GAME_VAULT_ADDRESS).
DEPLOYMENTS_FILE=../../contracts/deployments/anvil.json

# Crédito dos depósitos do GameVault: o gateway diz de quem é a carteira, o economy lança o SCITY.
# Os tokens são o INTERNAL_TOKEN de cada serviço. Sem os quatro, os depósitos só ficam registrados.
GATEWAY_URL=http://127.0.0.1:8000
GATEWAY_TOKEN=
ECONOMY_URL=http://127.0.0.1:8010
ECONOMY_TOKEN=

# Observabilidade (infra/observability).
LOG_LEVEL=info
METRICS_TOKEN=
