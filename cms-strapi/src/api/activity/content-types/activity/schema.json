{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "Atividade",
    "description": "Atividades fora do trabalho e o efeito de cada uma nos atributos do avatar (GDD, seção 4.5). A UI mostra só a direção do efeito."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "code": { "type": "uid", "required": true },
    "label": { "type": "string", "required": true },
    "group": {
      "type": "enumeration",
      "enum": ["transportes", "pets", "educacao", "alimentacao", "parque", "ginasio", "galeria", "hospital", "academia", "lojas", "moradia", "higiene"],
      "required": true
    },
    "energy": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "health": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "happiness": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "food": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "hygiene": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "conferir": { "type": "json" }
  }
}
