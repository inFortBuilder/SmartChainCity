{
  "kind": "collectionType",
  "collectionName": "foods",
  "info": {
    "singularName": "food",
    "pluralName": "foods",
    "displayName": "Alimento",
    "description": "Alimentos do jogo: efeito na energia e na saúde, pacote e preço (Tabela de Atributos, doc 02 §7). Inventário do jogador fica no game-core."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {},
  "attributes": {
    "code": { "type": "uid", "required": true },
    "label": { "type": "string", "required": true },
    "group": { "type": "enumeration", "enum": ["fruta", "grao_legume", "proteina", "lanche"], "required": true },
    "energy": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "health": { "type": "integer", "required": true, "default": 0, "min": -10, "max": 10 },
    "pack": { "type": "integer", "required": true, "default": 1, "min": 1 },
    "farmLevel": { "type": "integer", "min": 1, "max": 3 },
    "price": { "type": "integer", "min": 0 },
    "conferir": { "type": "json" }
  }
}
