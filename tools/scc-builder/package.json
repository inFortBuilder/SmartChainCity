{
  "name": "scc-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SCC Builder — converte e otimiza modelos arquitetônicos para os prédios da Smart Chain City: editor Web 3D, CLI com preset scc (Y-up, metros, Meshopt, LODs) e API PHP com JWT do gateway SCC e validação de lote.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "convert": "node bin/convert.js",
    "worker": "php bin/worker.php",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css,json,md}\"",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "instalar": "php bin/instalar.php",
    "validar": "php bin/validar.php",
    "test:php": "php tests/php/run.php"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "draco3dgltf": "^1.5.7",
    "jszip": "^3.10.1",
    "lucide": "^0.460.0",
    "meshoptimizer": "^0.22.0",
    "three": "^0.170.0"
  },
  "optionalDependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
