# Caminho público onde a aplicação será servida (precisa terminar com /)
VITE_BASE_PATH=/scc-builder/

# URL base da API REST PHP (sem barra final)
VITE_API_BASE_URL=/scc-builder/api

# Em produção o editor recebe o JWT do jogador pelo link do jogo
# (#token=<jwt>, emitido pelo gateway SCC). Os dois campos abaixo são
# SÓ para desenvolvimento local — nunca preencha num build público:
# o valor vai embutido no JavaScript e qualquer visitante o lê.
#
# JWT de teste (gere com: php bin/token-dev.php <account_id>)
VITE_SCC_TOKEN=
# ou uma das chaves de api/config.local.php
VITE_API_KEY=

# Mapa da Smart Chain City que recebe o prédio ("Exportar para o mapa").
# Vazio em desenvolvimento = protótipo em http://localhost:8081/docs/proposta-cidade-realista/index.html
VITE_SCC_MAP_URL=

# Porta do dev server
VITE_DEV_PORT=5173

# false = não abre o navegador ao rodar npm run dev
VITE_OPEN=true
